                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },

                empresas_publicas: {
                    id: 'empresas_publicas',
                    title: 'DECLARAÇÃO DE REGULARIDADE NO FORNECIMENTO DA RELAÇÃO DAS EMPRESAS PÚBLICAS E DAS SOCIEDADES DE ECONOMIA MISTA AO REGISTRO PÚBLICO DE EMPRESAS MERCANTIS E ATIVIDADES AFINS E REGULARIDADE NA CONTRATAÇÃO DE OPERAÇÃO DE CRÉDITO COM INSTITUIÇÃO FINANCEIRA\nINCISOS XX E XXXII DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento aos incisos XX e XXXII do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se:\na) regular no fornecimento da relação das empresas públicas e das sociedades de economia mista junto ao Registro Público de Empresas Mercantis e Atividades Afins, nos termos do art. 92 da Lei nº 13.303, de 30 de junho de 2016; e\nb) regular na contratação de operação de crédito com instituição financeira, nos termos do art. 33 da Lei Complementar nº 101, de 4 de maio de 2000.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },
                limites_cumprimento: {
                    id: 'limites_cumprimento',
                    title: (configuracoes.ate65milHabitantes)
                        ? 'DECLARAÇÃO DE REGULARIDADE NO CUMPRIMENTO DE LIMITES\nINCISO XXXI DO ART 29 DA PC 33, DE 2023'
                        : 'DECLARAÇÃO DE REGULARIDADE NO CUMPRIMENTO DE LIMITES\nINCISOS XXIX, XXX e XXXI DO ART 29 DA PC 33, DE 2023',
                    content: (configuracoes.ate65milHabitantes)
                        ? `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao inciso XXXI, do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se regular:\nI. no cumprimento do limite de despesa total com pessoal de todos os Poderes e órgãos listados no art. 20 da Lei Complementar nº 101, de 4 de maio de 2000, inclusive as Defensorias Públicas, nos termos do art. 169, § 2º, da Constituição Federal, e do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000.`
                        : `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento aos incisos XXIX, XXX e XXXI, do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se regular:\nI. no cumprimento do limite das dívidas consolidada e mobiliária, nos termos do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000;\nII. no cumprimento do limite de inscrição em restos a pagar, nos termos do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000; e\nIII. no cumprimento do limite de despesa total com pessoal de todos os Poderes e órgãos listados no art. 20 da Lei Complementar nº 101, de 4 de maio de 2000, inclusive as Defensorias Públicas, nos termos do art. 169, § 2º, da Constituição Federal, e do art. 25, § 1º, inciso IV, alínea "c", da Lei Complementar nº 101, de 4 de maio de 2000.`,
                    footer: novoTextoRodapeLongo
                },
                precatorios_educacao_regular: {
                    id: 'precatorios_educacao_regular',
                    title: 'DECLARAÇÃO DE REGULARIDADE NA DESTINAÇÃO DOS PRECATÓRIOS CORRESPONDENTES AO RATEIO DOS PERCENTUAIS DESTINADOS AOS PROFISSIONAIS DO MAGISTÉRIO E AOS DEMAIS PROFISSIONAIS DA EDUCAÇÃO BÁSICA\nINCISO XXXIII DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ: ${cnpj}, declaro, sob as penas da lei, que${entityText ? ` o Município de ${entityText}` : ''} encontra-se regular quanto à destinação dos precatórios correspondentes ao rateio dos percentuais destinados aos profissionais do magistério e aos demais profissionais da educação básica, estabelecido no art. 47-A, §§ 1º e 2º, da Lei nº 14.113, de 25 de dezembro de 2020, e no art. 3º da Lei nº 14.325, de 12 de abril de 2022.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                },
                precatorios_educacao_ausencia: {
                    id: 'precatorios_educacao_ausencia',
                    title: 'DECLARAÇÃO DE AUSÊNCIA DE PRECATÓRIOS CORRESPONDENTES AO RATEIO DOS PERCENTUAIS DESTINADOS AOS PROFISSIONAIS DO MAGISTÉRIO E AOS DEMAIS PROFISSIONAIS DA EDUCAÇÃO BÁSICA\n§ 16 DO ART. 29 DA PC 33, DE 2023',
                    content: `Eu, ${nome}, na condição de ${representanteText}, CNPJ nº ${cnpj}, declaro para os devidos fins de celebração de Convênio no âmbito do Ministério do Esporte - MESP, em cumprimento ao § 16 do art. 29 da Portaria Conjunta MGI/MF/CGU Nº 33, de 30 de agosto de 2023, sob as penas da lei, que${entityText ? ` o Município de ${entityText}${addressText}` : ''} encontra-se inexistente da obrigação referente aos precatórios correspondentes ao rateio dos percentuais destinados aos profissionais do magistério e aos demais profissionais da educação básica, estabelecido no art. 47-A, §§ 1º e 2º, da Lei nº 14.113, de 2020, e no art. 3º da Lei nº 14.325, de 2022.`,
                    footer: 'Declaração válida somente no mês da assinatura, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas'
                }
            };

            const declaracoesSelecionadas = [];

            if (opcao === '20JP_00SL_emenda') {
                declaracoesSelecionadas.push(configuracoes.possuiAreaGestora
                    ? declaracoesBase.area_gestora_existe_taxa
                    : declaracoesBase.area_gestora_inexiste_taxa);
            } else if (opcao === '20JP_00SL_comissao') {
                if (!configuracoes.apresentaraCertidoes) {
                    declaracoesSelecionadas.push(declaracoesBase.precatorios_judiciais);
                }
                declaracoesSelecionadas.push(declaracoesBase.empresas_publicas);
                declaracoesSelecionadas.push(declaracoesBase.limites_cumprimento);
                declaracoesSelecionadas.push(configuracoes.regularPrecatorios
                    ? declaracoesBase.precatorios_educacao_regular
                    : declaracoesBase.precatorios_educacao_ausencia);
                declaracoesSelecionadas.push(configuracoes.possuiAreaGestora
                    ? declaracoesBase.area_gestora_existe_taxa
                    : declaracoesBase.area_gestora_inexiste_taxa);
            }
            return declaracoesSelecionadas.filter(d => d);
        };

        // Cabeçalho com nome e endereço da entidade (repetido em todas as páginas)
        // Nome do arquivo da Área Gestora conforme a opção marcada (Existência × Inexistência)
        const nomeArquivoAreaGestora = (declId, nomeResponsavel) => {
            const tipo = declId === 'area_gestora_existe_taxa' ? 'Existência' : 'Inexistência';
            return `Declaração_de_${tipo}_de_Área_Gestora_${nomeResponsavel.replace(/\s+/g, '_')}.pdf`;
        };

        const cabecalhoEntidade = (dados) => ([
            { text: dados.nomeEntidade || 'Entidade não informada', style: 'entityName' },
            { text: `${dados.endereco || 'Endereço não informado'} - ${dados.cidadeUF || 'Município/UF não informado'} - CEP: ${dados.cep || 'CEP não informado'}`, style: 'entityAddress' },
            { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#cccccc' }], margin: [0, 0, 0, 10] }
        ]);

        const blocoAssinatura = (dados) => ({
            stack: [
                { text: `${dados.cidadeUF.split('/')[0].toUpperCase()}, na data da assinatura eletrônica.`, alignment: 'center', fontSize: 11, margin: [0, 20, 0, 10] },
                { text: '__________________________________________', alignment: 'center', fontSize: 11, margin: [0, 10, 0, 5] },
                { text: dados.nome, alignment: 'center', bold: true, fontSize: 11 },
                { text: dados.cargo, alignment: 'center', italics: true, fontSize: 11 }
            ],
            unbreakable: true
        });

        const createDeclarationContent = (declaracao, dados, { withSignature = false } = {}) => {
            const contentStack = [
                ...cabecalhoEntidade(dados),
                { text: declaracao.title, style: 'header', alignment: 'center', margin: [0, 15, 0, 20] },
                { text: declaracao.content, alignment: 'justify', fontSize: 12, lineHeight: 1.15, margin: [0, 0, 0, 30] }
            ];
            if (withSignature) contentStack.push(blocoAssinatura(dados));
            return { stack: contentStack };
        };

        // Página de anexo: cada página do PDF enviado vira uma imagem
        const createAnexoPageContent = ({ anexo, subnumero, img, indicePagina, declaracao, dados }) => ({
            pageBreak: 'before',
            stack: [
                ...cabecalhoEntidade(dados),
                { text: `ANEXO ${subnumero} – ${anexo.titulo}`, style: 'header', alignment: 'center', margin: [0, 8, 0, 4] },
                { text: `Vinculado à ${declaracao.title.split('\n')[0]}`, style: 'anexoInfo' },
                { text: `Arquivo: ${anexo.nomeArquivo} – página ${indicePagina + 1} de ${anexo.paginas.length}`, style: 'anexoInfo', margin: [0, 0, 0, 8] },
                {
                    table: { widths: ['*'], body: [[{ image: img.dataUrl, fit: [499, 490], alignment: 'center' }]] },
                    layout: {
                        hLineWidth: () => 0.5, vLineWidth: () => 0.5,
                        hLineColor: () => '#bbbbbb', vLineColor: () => '#bbbbbb',
                        paddingLeft: () => 4, paddingRight: () => 4, paddingTop: () => 4, paddingBottom: () => 4
                    }
                }
            ]
        });

        const createLastPageContent = (indice, qtdDeclaracoes, qtdAnexos, dados) => {
            const corpoTabela = [
                [
                    { text: 'Item', style: 'tableHeader' },
                    { text: 'Descrição', style: 'tableHeader' },
                    { text: 'Página', style: 'tableHeader' }
                ],
                ...indice.map(linha => {
                    const paginas = linha.paginaInicial === linha.paginaFinal
                        ? `${linha.paginaInicial}`
                        : `${linha.paginaInicial} a ${linha.paginaFinal}`;
                    return [
                        { text: linha.numero, alignment: 'center', fontSize: 9, bold: !linha.anexo },
                        {
                            text: linha.titulo, linkToPage: linha.paginaInicial, decoration: 'underline',
                            color: '#1351b4', fontSize: linha.anexo ? 8.5 : 9,
                            margin: linha.anexo ? [14, 0, 0, 0] : [0, 0, 0, 0]
                        },
                        { text: paginas, alignment: 'center', fontSize: 9 }
                    ];
                })
            ];

            const textoDecl = qtdDeclaracoes === 1
                ? 'Por ser verdade, firmo o teor da declaração que compõe este arquivo'
                : `Por ser verdade, firmo o teor das ${numToWords(qtdDeclaracoes)} (${qtdDeclaracoes}) declarações que compõem este arquivo`;
            const textoAnexos = qtdAnexos === 0 ? ''
                : qtdAnexos === 1
                    ? ', acompanhada(s) de um (1) anexo nele incorporado'
                    : `, acompanhada(s) de ${numToWords(qtdAnexos, 'm')} (${qtdAnexos}) anexos nele incorporados`;

            return {
                pageBreak: 'before',
                stack: [
                    ...cabecalhoEntidade(dados),
                    { text: 'DECLARAÇÕES REFERENCIAIS', style: 'header', alignment: 'center', margin: [0, 15, 0, 15] },
                    {
                        text: qtdAnexos
                            ? 'Relação das declarações e dos anexos contidos neste documento, assinados eletronicamente na presente página.'
                            : 'Relação das declarações contidas neste documento, assinadas eletronicamente na presente página.',
                        style: 'subheader', margin: [0, 5, 0, 10]
                    },
                    {
                        table: { headerRows: 1, widths: [34, '*', 44], body: corpoTabela },
                        layout: {
                            hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1.5 : 0.5,
                            vLineWidth: () => 1,
                            hLineColor: () => '#1351b4',
                            vLineColor: () => '#1351b4',
                            paddingLeft: () => 5,
                            paddingRight: () => 5,
                            paddingTop: () => 2,
                            paddingBottom: () => 2
                        },
                        margin: [0, 10, 0, 20]
                    },
                    { text: `${textoDecl}${textoAnexos}:`, alignment: 'justify', fontSize: 11, margin: [0, 20, 0, 10] },
                    blocoAssinatura(dados)
                ]
            };
        };

        const gerarPDFPrincipal = (declaracoes, dados, watermarkImage) => {
            return new Promise((resolve, reject) => {
                try {
                    const qtdAnexos = declaracoes.reduce((total, d) => total + (d.anexos?.length || 0), 0);
                    const usarFolhaReferencial = declaracoes.length > 1 || qtdAnexos > 0;

                    const conteudo = [];
                    const rodapes = [];   // rodapé de cada página física (exceto a folha de assinatura)
                    const indice = [];    // linhas da tabela de referência

                    declaracoes.forEach((decl, i) => {
                        const numero = String(i + 1);
                        const bloco = createDeclarationContent(decl, dados, { withSignature: !usarFolhaReferencial });
                        if (conteudo.length) bloco.pageBreak = 'before';
                        conteudo.push(bloco);
                        rodapes.push(decl.footer);
                        indice.push({ numero, titulo: decl.title, paginaInicial: rodapes.length, paginaFinal: rodapes.length, anexo: false });

                        (decl.anexos || []).forEach((anexo, j) => {
                            const subnumero = `${numero}.${j + 1}`;
                            const paginaInicial = rodapes.length + 1;
                            anexo.paginas.forEach((img, k) => {
                                conteudo.push(createAnexoPageContent({ anexo, subnumero, img, indicePagina: k, declaracao: decl, dados }));
                                rodapes.push(`Anexo ${subnumero} da declaração do item ${numero} – página ${k + 1} de ${anexo.paginas.length} do arquivo enviado`);
                            });
                            indice.push({ numero: subnumero, titulo: `ANEXO ${subnumero} – ${anexo.titulo}`, paginaInicial, paginaFinal: rodapes.length, anexo: true });
                        });
                    });

                    if (usarFolhaReferencial) {
                        conteudo.push(createLastPageContent(indice, declaracoes.length, qtdAnexos, dados));
                    }

                    const qtdDecl = declaracoes.length;
                    const textoRodapeFinal =
                        `Documento composto por ${qtdDecl} (${numToWords(qtdDecl)}) ${qtdDecl === 1 ? 'declaração' : 'declarações'}` +
                        (qtdAnexos ? ` e ${qtdAnexos} (${numToWords(qtdAnexos, 'm')}) ${qtdAnexos === 1 ? 'anexo' : 'anexos'}` : '') +
                        ', assinado eletronicamente nesta página';

                    const docDefinition = {
                        pageSize: 'A4',
                        pageMargins: [40, 80, 40, 80],
                        background: () => watermarkImage ? { image: watermarkImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 } } : null,
                        footer: (currentPage, pageCount) => {
                            const footerText = (usarFolhaReferencial && currentPage === pageCount)
                                ? textoRodapeFinal
                                : rodapes[currentPage - 1];
                            if (!footerText) return null;
                            const isLongText = footerText.includes('RGF');
                            return {
                                margin: [40, 10, 40, 0],
                                stack: [
                                    { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#AAAAAA' }], margin: [0, 0, 0, 5] },
                                    {
                                        columns: [
                                            { text: footerText, alignment: isLongText ? 'justify' : 'left', fontSize: 8, color: '#555' },
                                            { text: `Página ${currentPage} de ${pageCount}`, alignment: 'right', fontSize: 8, color: '#555', width: 'auto' }
                                        ]
                                    }
                                ]
                            };
                        },
                        content: conteudo,
                        styles: {
                            header: { fontSize: 12, bold: true, color: '#0c326f' },
                            subheader: { fontSize: 10, italics: true, color: '#333333' },
                            entityName: { bold: true, alignment: 'center', fontSize: 14, margin: [0, 0, 0, 2] },
                            entityAddress: { fontSize: 9, alignment: 'center', margin: [0, 0, 0, 5] },
                            anexoInfo: { fontSize: 9, alignment: 'center', italics: true, color: '#555555' },
                            tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#1351b4', alignment: 'center' }
                        },
                        defaultStyle: { font: 'Roboto', alignment: 'justify' }
                    };

                    let fileName = '';
                    if (usarFolhaReferencial) {
                        fileName = `Declarações_COM_Envio_ao_TCE_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                    } else {
                        const singleDeclId = declaracoes[0].id;
                        if (singleDeclId === 'area_gestora_existe_taxa' || singleDeclId === 'area_gestora_inexiste_taxa') {
                            fileName = nomeArquivoAreaGestora(singleDeclId, dados.nome);
                        } else {
                            fileName = `Declaração_${dados.nome.replace(/\s+/g, '_')}.pdf`;
                        }
                    }

                    pdfMake.createPdf(docDefinition).getBlob(blob => resolve({ nome: fileName, blob }));
                } catch (error) {
                    reject(error);
                }
            });
        };

        // ===== 3º DOCUMENTO: ANEXOS DA DECLARAÇÃO DE PRECATÓRIOS (arquivo separado) =====
        const TITULO_DECL_PRECATORIOS = 'DECLARAÇÃO DE REGULARIDADE NO PAGAMENTO DE PRECATÓRIOS JUDICIAIS';
        const nomeArquivoAnexos = (dados, complementacao) =>
            `${complementacao ? 'Anexos_Complementares' : 'Anexos'}_Declaração_de_Precatórios_Judiciais_${dados.nome.replace(/\s+/g, '_')}.pdf`;

        const gerarPDFAnexos = (anexos, dados, watermarkImage, { complementacao = false } = {}) => {
            return new Promise((resolve, reject) => {
                try {
                    const declaracao = { title: TITULO_DECL_PRECATORIOS };
                    const conteudo = [];
                    const rodapes = [complementacao
                        ? 'Índice dos anexos complementares da Declaração de Regularidade no Pagamento de Precatórios Judiciais'
                        : 'Índice dos anexos da Declaração de Regularidade no Pagamento de Precatórios Judiciais'];
                    const indice = [];

                    anexos.forEach((anexo) => {
                        const paginaInicial = rodapes.length + 1;
                        anexo.paginas.forEach((img, k) => {
                            conteudo.push(createAnexoPageContent({ anexo, subnumero: anexo.subnumero, img, indicePagina: k, declaracao, dados }));
                            rodapes.push(`Anexo ${anexo.subnumero} – página ${k + 1} de ${anexo.paginas.length} do arquivo enviado`);
                        });
                        indice.push({ subnumero: anexo.subnumero, titulo: anexo.titulo, nomeArquivo: anexo.nomeArquivo, paginaInicial, paginaFinal: rodapes.length });
                    });

                    const hoje = new Date().toLocaleDateString('pt-BR');
                    const capa = {
                        stack: [
                            ...cabecalhoEntidade(dados),
                            {
                                text: complementacao
                                    ? 'ANEXOS COMPLEMENTARES DA DECLARAÇÃO DE REGULARIDADE NO PAGAMENTO DE PRECATÓRIOS JUDICIAIS'
                                    : 'ANEXOS DA DECLARAÇÃO DE REGULARIDADE NO PAGAMENTO DE PRECATÓRIOS JUDICIAIS',
                                style: 'header', alignment: 'center', margin: [0, 15, 0, 6]
                            },
                            { text: 'ART. 29, INCISO II, C/C § 6º DA PORTARIA CONJUNTA MGI/MF/CGU Nº 33, DE 30 DE AGOSTO DE 2023', style: 'header', fontSize: 10, alignment: 'center', margin: [0, 0, 0, 18] },
                            {
                                text: complementacao
                                    ? `Documentos encaminhados em complementação aos anexos da Declaração de Regularidade no Pagamento de Precatórios Judiciais (item 1 do arquivo de declarações), conforme solicitação da SNEAELIS/Ministério do Esporte. A numeração dos subitens segue a do arquivo de anexos original.`
                                    : `Documentos que acompanham a Declaração de Regularidade no Pagamento de Precatórios Judiciais (item 1 do arquivo de declarações), apresentados em razão da impossibilidade de emissão das certidões do TJ, do TRT e do TRF, conforme o § 6º do art. 29 da referida Portaria Conjunta.`,
                                fontSize: 11, alignment: 'justify', lineHeight: 1.15, margin: [0, 0, 0, 8]
                            },
                            { text: `Arquivo gerado em ${hoje}.`, fontSize: 9, italics: true, color: '#555555', margin: [0, 0, 0, 14] },
                            {
                                table: {
                                    headerRows: 1,
                                    widths: [34, '*', 50],
                                    body: [
                                        [
                                            { text: 'Item', style: 'tableHeader' },
                                            { text: 'Documento', style: 'tableHeader' },
                                            { text: 'Página', style: 'tableHeader' }
                                        ],
                                        ...indice.map(l => [
                                            { text: l.subnumero, alignment: 'center', fontSize: 9, bold: true },
                                            {
                                                stack: [
                                                    { text: l.titulo, linkToPage: l.paginaInicial, decoration: 'underline', color: '#1351b4', fontSize: 9 },
                                                    { text: `Arquivo enviado: ${l.nomeArquivo}`, fontSize: 8, italics: true, color: '#555555', margin: [0, 2, 0, 0] }
                                                ]
                                            },
                                            { text: l.paginaInicial === l.paginaFinal ? `${l.paginaInicial}` : `${l.paginaInicial} a ${l.paginaFinal}`, alignment: 'center', fontSize: 9 }
                                        ])
                                    ]
                                },
                                layout: {
                                    hLineWidth: (i, node) => (i === 0 || i === node.table.body.length) ? 1.5 : 0.5,
                                    vLineWidth: () => 1,
                                    hLineColor: () => '#1351b4',
                                    vLineColor: () => '#1351b4',
                                    paddingLeft: () => 5, paddingRight: () => 5, paddingTop: () => 3, paddingBottom: () => 3
                                }
                            }
                        ]
                    };
                    conteudo.unshift(capa);

                    const docDefinition = {
                        pageSize: 'A4',
                        pageMargins: [40, 80, 40, 80],
                        background: () => watermarkImage ? { image: watermarkImage, width: 595.28, height: 841.89, absolutePosition: { x: 0, y: 0 } } : null,
                        footer: (currentPage, pageCount) => ({
                            margin: [40, 10, 40, 0],
                            stack: [
                                { canvas: [{ type: 'line', x1: 0, y1: 5, x2: 515, y2: 5, lineWidth: 0.5, lineColor: '#AAAAAA' }], margin: [0, 0, 0, 5] },
                                {
                                    columns: [
                                        { text: rodapes[currentPage - 1] || '', alignment: 'left', fontSize: 8, color: '#555' },
                                        { text: `Página ${currentPage} de ${pageCount}`, alignment: 'right', fontSize: 8, color: '#555', width: 'auto' }
                                    ]
                                }
                            ]
                        }),
                        content: conteudo,
                        styles: {
                            header: { fontSize: 12, bold: true, color: '#0c326f' },
                            entityName: { bold: true, alignment: 'center', fontSize: 14, margin: [0, 0, 0, 2] },
                            entityAddress: { fontSize: 9, alignment: 'center', margin: [0, 0, 0, 5] },
                            anexoInfo: { fontSize: 9, alignment: 'center', italics: true, color: '#555555' },
                            tableHeader: { fontSize: 10, bold: true, color: '#FFFFFF', fillColor: '#1351b4', alignment: 'center' }
                        },
                        defaultStyle: { font: 'Roboto', alignment: 'justify' }
                    };

                    const nome = nomeArquivoAnexos(dados, complementacao);
                    pdfMake.createPdf(docDefinition).getBlob(blob => resolve({ nome, blob }));
                } catch (error) {
                    reject(error);
                }
            });
        };

        const gerarPDFDeclaracaoSeparada = (declaracao, dados, watermarkImage) =>
            gerarPDFPrincipal([declaracao], dados, watermarkImage);

        const processarGeracaoPDFs = async () => {
            try {
                const dados = {
                    nome: document.getElementById('nomeResponsavel')?.value.trim() || '',
                    cargo: getCargoInformado(),
                    cnpj: document.getElementById('cnpj')?.value.trim() || '',
                    cep: document.getElementById('cep')?.value.trim() || '',
                    endereco: document.getElementById('endereco')?.value.trim() || '',
                    complemento: document.getElementById('complemento')?.value.trim() || '',
                    cidadeUF: document.getElementById('cidadeUF')?.value.trim() || '',
                    nomeEstadoMunicipio: document.getElementById('nomeEstadoMunicipio')?.value.trim() || '',
                    nomeEntidade: document.getElementById('nomeEstadoMunicipio')?.value.trim() || nomeEntidadeGlobal || ''
                };

                if (!dados.cargo) {
                    showTab('aba1');
                    validateTab('aba1');
                    throw new Error('Informe o cargo do responsável na etapa "Responsável".');
                }

                const modoAnexos = modoAnexosApenas();
                const nomeArq = dados.nome.replace(/\s+/g, '_');

                const declaracoesParaArquivoPrincipal = [];
                const declaracoesParaArquivoSeparado = [];

                if (!modoAnexos) {
                    const configuracoes = {
                        possuiAreaGestora: document.getElementById('possuiAreaGestora')?.checked || false,
                        apresentaraCertidoes: document.getElementById('apresentaraCertidoes')?.checked || false,
                        ate65milHabitantes: document.getElementById('ate65milHabitantes')?.checked || false,
                        regularPrecatorios: document.getElementById('regularPrecatorios')?.checked || false
                    };

                    const declaracaoTipos = Array.from(document.querySelectorAll('input[name="declaracaoTipo"]:checked')).map(cb => cb.value);
                    if (declaracaoTipos.length === 0) {
                        throw new Error('Nenhum tipo de declaração foi selecionado na etapa "Entidade".');
                    }

                    let todas = [];
                    declaracaoTipos.forEach(opcao => todas.push(...getDeclaracoes(opcao, dados, configuracoes)));
                    todas = [...new Map(todas.map(item => [item.id, item])).values()];

                    todas.forEach(decl => {
                        if (decl.id === 'area_gestora_inexiste_taxa' || decl.id === 'area_gestora_existe_taxa') {
                            declaracoesParaArquivoSeparado.push(decl);
                        } else {
                            declaracoesParaArquivoPrincipal.push(decl);
                        }
                    });
                }

                const exigeAnexos = modoAnexos || declaracoesParaArquivoPrincipal.some(d => d.id === 'precatorios_judiciais');
                if (exigeAnexos && !validarAnexos()) {
                    throw new Error('Verifique os anexos destacados em vermelho na etapa "Finalizar".');
                }
                const anexos = exigeAnexos ? anexosSelecionados() : [];

                // Plano de arquivos (cada um gerado separadamente, sem download automático)
                const plano = [];
                if (declaracoesParaArquivoPrincipal.length > 0) {
                    const n = declaracoesParaArquivoPrincipal.length;
                    plano.push({
                        nome: `Declarações_COM_Envio_ao_TCE_${nomeArq}.pdf`,
                        detalhe: `${n} ${n === 1 ? 'declaração' : 'declarações'}${n > 1 ? ' + folha de assinatura' : ''}.`,
                        gerar: (wm) => gerarPDFPrincipal(declaracoesParaArquivoPrincipal, dados, wm)
                    });
                }
                declaracoesParaArquivoSeparado.forEach(decl => {
                    plano.push({
                        nome: nomeArquivoAreaGestora(decl.id, dados.nome),
                        detalhe: decl.id === 'area_gestora_existe_taxa' ? 'Existência de área gestora.' : 'Inexistência de área gestora.',
                        gerar: (wm) => gerarPDFPrincipal([decl], dados, wm)
                    });
                });
                if (anexos.length > 0) {
                    const totalPaginas = anexos.reduce((t, a) => t + a.paginas.length, 0);
                    plano.push({
                        nome: nomeArquivoAnexos(dados, modoAnexos),
                        detalhe: `Anexos ${anexos.map(a => a.subnumero).join(', ')}: índice + ${totalPaginas} ${totalPaginas === 1 ? 'página' : 'páginas'} em imagem.`,
                        gerar: (wm) => gerarPDFAnexos(anexos, dados, wm, { complementacao: modoAnexos })
                    });
                }

                if (plano.length === 0) {
                    throw new Error('Nenhum documento a gerar. Verifique suas seleções e os dados inseridos.');
                }

                // Confirmação
                const confirmationPopup = document.getElementById('confirmationPopup');
                const fileList = document.getElementById('fileList');
                const confirmDownloadBtn = document.getElementById('confirmDownloadBtn');
                const cancelPopupBtn = document.getElementById('cancelPopupBtn');

                fileList.innerHTML = plano
                    .map(a => `<li>${escapeHtml(a.nome)}<small>${escapeHtml(a.detalhe)}</small></li>`)
                    .join('');
                document.getElementById('assinanteResumo').textContent = `${dados.nome} (${dados.cargo})`;
                confirmationPopup.classList.add('show');
                overlay.classList.add('show');

                const closeConfirmationPopup = () => {
                    confirmationPopup.classList.remove('show');
                    overlay.classList.remove('show');
                };

                await new Promise((resolve, reject) => {
                    const cleanup = () => {
                        confirmDownloadBtn.removeEventListener('click', onConfirm);
                        cancelPopupBtn.removeEventListener('click', onCancel);
                    };
                    const onConfirm = () => { closeConfirmationPopup(); cleanup(); resolve(); };
                    const onCancel = () => { closeConfirmationPopup(); cleanup(); reject(new Error('Geração de PDFs cancelada pelo usuário.')); };
                    confirmDownloadBtn.addEventListener('click', onConfirm, { once: true });
                    cancelPopupBtn.addEventListener('click', onCancel, { once: true });
                });

                toggleLoading(true, 'Gerando documento(s)...');
                const watermarkImage = await getBase64ImageFromUrl('https://i.ibb.co/Q7tqVPBb/Folha-Limpa.jpg');

                const resultados = [];
                const falhas = [];
                for (const item of plano) {
                    try {
                        const r = await item.gerar(watermarkImage);
                        resultados.push({ nome: r.nome, blob: r.blob, detalhe: item.detalhe });
                    } catch (err) {
                        console.error(`Falha ao gerar ${item.nome}:`, err);
                        falhas.push(item.nome);
                    }
                }

                toggleLoading(false);
                if (resultados.length) {
                    mostrarResultados(resultados, `${modoAnexos ? 'Anexos_Complementares' : 'Declarações'}_${nomeArq}.zip`);
                }
                if (falhas.length) {
                    alert(`Não foi possível gerar: ${falhas.join(', ')}. Tente novamente; se persistir, verifique os PDFs anexados.`);
                }

            } catch (error) {
                console.error('Erro ao gerar PDF(s):', error);
                if (error.message !== 'Geração de PDFs cancelada pelo usuário.') {
                    alert(error.message || 'Ocorreu um erro ao gerar o(s) documento(s). Tente novamente.');
                }
            } finally {
                toggleLoading(false);
            }
        };

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (validateTab(tabs[tabs.length - 1])) {
                await processarGeracaoPDFs();
            }
        });

        pdfMake.fonts = {
            Roboto: {
                normal: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Regular.ttf',
                bold: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Medium.ttf',
                italics: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-Italic.ttf',
                bolditalics: 'https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/fonts/Roboto/Roboto-MediumItalic.ttf'
            }
        };

        showTab('aba1');
    });
</script>
</body>
</html>