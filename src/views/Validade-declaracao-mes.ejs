<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1351b4">
    <meta name="description" content="Gerador de Declarações para Entidades Públicas — Ministério do Esporte. Padronizado conforme o Design System do Governo Federal (gov.br).">
    <title>Gerador de Declarações — Ministério do Esporte | gov.br</title>

    <!-- Fonte oficial gov.br: Rawline (com fallback Raleway) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://cdngovbr-ds.estaleiro.serpro.gov.br/design-system/fonts/rawline/css/rawline.css">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css">

    <style>
        /* ============================================================
           TOKENS — Design System do Governo Federal (gov.br / DSGov)
           ============================================================ */
        :root {
            --blue-90: #051d41;
            --blue-80: #0c326f;
            --blue-70: #1351b4;
            --blue-60: #155bcb;
            --blue-50: #2670e8;
            --blue-20: #c5d4eb;
            --blue-10: #e8eefa;
            --gold:    #ffcd07;

            --success: #168821;
            --danger:  #e52207;
            --warning: #c05600;
            --warning-bg: #fff5c2;
            --info:    #155bcb;

            --pure-0:   #ffffff;
            --gray-2:   #f8f8f8;
            --gray-5:   #f0f0f0;
            --gray-10:  #e6e6e6;
            --gray-20:  #cccccc;
            --gray-40:  #9e9e9e;
            --gray-60:  #666666;
            --gray-80:  #333333;

            --bg:            var(--gray-2);
            --surface:       var(--pure-0);
            --text:          var(--gray-80);
            --text-muted:    var(--gray-60);
            --border:        var(--gray-20);
            --accent:        var(--blue-70);
            --accent-hover:  var(--blue-80);
            --header-bg:     var(--pure-0);
            --footer-bg:     var(--blue-90);

            --radius:   8px;
            --shadow-1: 0 1px 3px rgba(0,0,0,.10);
            --shadow-2: 0 3px 6px rgba(0,0,0,.16);
            --focus:    0 0 0 4px var(--gold);
            --font-base: 'Rawline', 'Raleway', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        [data-theme="dark"] {
            --bg:           #0c1a2b;
            --surface:      #102845;
            --text:         #e9eef5;
            --text-muted:   #aebfd4;
            --border:       #244268;
            --accent:       #5a8bdd;
            --accent-hover: #7aa4e8;
            --header-bg:    #0a1626;
            --footer-bg:    #0a1626;
            --gray-2:       #0c1a2b;
            --gray-5:       #13294a;
            --pure-0:       #102845;
            --warning-bg:   rgba(255,205,7,.12);
            --shadow-1: 0 1px 3px rgba(0,0,0,.5);
            --shadow-2: 0 3px 8px rgba(0,0,0,.6);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        [hidden] { display: none !important; }

        html { font-size: 100%; }
        body {
            font-family: var(--font-base);
            font-size: 1rem;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            transition: background-color .3s ease, color .3s ease;
        }

        a { color: var(--accent); }

        a:focus-visible,
        button:focus-visible,
        input:focus-visible,
        select:focus-visible,
        .stepper-item:focus-visible {
            outline: none;
            box-shadow: var(--focus);
            border-radius: 4px;
        }

        .sr-only {
            position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
            overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
        }

        .skip-link {
            position: absolute; left: -999px; top: 0; z-index: 2000;
            background: var(--accent); color: #fff; padding: 10px 16px;
            border-radius: 0 0 var(--radius) 0; font-weight: 600;
        }
        .skip-link:focus { left: 0; }

        .container-lg { width: 100%; max-width: 1100px; margin: 0 auto; padding: 0 24px; }

        /* ===================== CABEÇALHO gov.br ===================== */
        header.br-header {
            background: var(--header-bg);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-1);
            position: sticky; top: 0; z-index: 1000;
        }
        .header-top {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 0; gap: 16px;
        }
        .header-brand { display: flex; align-items: center; gap: 14px; min-width: 0; }
        .govbr-logo {
            font-family: var(--font-base);
            font-weight: 800; font-size: 1.7rem; letter-spacing: -.5px;
            color: var(--blue-80); text-decoration: none; line-height: 1; white-space: nowrap;
        }
        [data-theme="dark"] .govbr-logo { color: #cfe0ff; }
        .govbr-logo .dot { color: var(--blue-70); }
        .header-divider { width: 1px; height: 34px; background: var(--border); flex: 0 0 auto; }
        .header-sign {
            font-weight: 700; font-size: 1.05rem; color: var(--text);
            overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .header-actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
        .header-btn {
            background: transparent; border: none; color: var(--accent);
            width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
            font-size: 1.15rem; display: inline-flex; align-items: center; justify-content: center;
            transition: background .2s ease;
        }
        .header-btn:hover { background: var(--blue-10); }
        [data-theme="dark"] .header-btn:hover { background: rgba(255,255,255,.08); }

        .header-bottom { padding: 0 0 16px; }
        .header-title { font-weight: 700; font-size: 1.25rem; color: var(--text); }
        .header-subtitle { font-size: .9rem; color: var(--text-muted); margin-top: 2px; }

        /* ===================== BREADCRUMB ===================== */
        nav.br-breadcrumb { padding: 14px 0 0; }
        .br-breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .85rem; }
        .br-breadcrumb li { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); }
        .br-breadcrumb a { color: var(--accent); text-decoration: none; }
        .br-breadcrumb a:hover { text-decoration: underline; }
        .br-breadcrumb .sep { color: var(--gray-40); font-size: .7rem; }
        .br-breadcrumb [aria-current="page"] { color: var(--text); font-weight: 600; }

        /* ===================== CARTÃO PRINCIPAL ===================== */
        main { padding: 8px 0 56px; }
        .br-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-1);
            padding: 32px 36px;
            margin-top: 18px;
        }
        .card-head { border-bottom: 2px solid var(--accent); padding-bottom: 16px; margin-bottom: 28px; }
        .card-head h1 { font-size: 1.6rem; font-weight: 700; color: var(--text); }
        .card-head .tag {
            display: inline-block; margin-top: 8px; font-size: .8rem; font-weight: 600;
            color: var(--accent); background: var(--blue-10); border: 1px solid var(--blue-20);
            padding: 3px 12px; border-radius: 100px;
        }
        [data-theme="dark"] .card-head .tag { background: rgba(90,139,221,.18); border-color: transparent; }

        /* ===================== STEPPER ===================== */
        .stepper-nav { margin-bottom: 36px; }
        .stepper-wrapper { display: flex; justify-content: space-between; position: relative; }
        .stepper-wrapper::before {
            content: ''; position: absolute; top: 22px; left: 6%; right: 6%; height: 3px;
            background: var(--border); z-index: 0;
        }
        .stepper-progress {
            content: ''; position: absolute; top: 22px; left: 6%; height: 3px;
            background: var(--accent); z-index: 1; width: 0; transition: width .5s ease;
        }
        .stepper-item {
            display: flex; flex-direction: column; align-items: center; text-align: center;
            width: 33.33%; position: relative; z-index: 2; background: transparent; border: none;
        }
        .step-counter {
            width: 46px; height: 46px; border-radius: 50%;
            background: var(--surface); border: 3px solid var(--border); color: var(--gray-40);
            display: flex; justify-content: center; align-items: center;
            font-size: 1.1rem; font-weight: 700; transition: all .35s ease;
        }
        .step-name { font-size: .85rem; font-weight: 600; color: var(--text-muted); margin-top: 10px; }
        .stepper-item.active .step-counter {
            border-color: var(--accent); color: var(--accent); background: var(--surface); transform: scale(1.08);
        }
        .stepper-item.active .step-name { color: var(--text); }
        .stepper-item.completed .step-counter { background: var(--accent); border-color: var(--accent); color: #fff; }
        .stepper-item.completed { cursor: pointer; }
        .stepper-item.completed:hover .step-counter { box-shadow: 0 0 0 4px var(--blue-10); }

        /* ===================== ABAS / SEÇÕES ===================== */
        .tab { display: none; animation: fadeIn .35s ease; }
        .tab.active { display: block; }
        .section { margin-bottom: 22px; }
        .section h2 { font-size: 1.2rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
        .section h2::after {
            content: ''; display: block; width: 44px; height: 3px; background: var(--accent);
            border-radius: 2px; margin-top: 8px;
        }
        .section .helper { color: var(--text-muted); font-size: .92rem; margin-bottom: 18px; }

        .form-row { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 6px; }
        .form-group { flex: 1; min-width: 240px; margin-bottom: 14px; }
        .full-width { flex-basis: 100%; }

        label {
            display: block; font-size: .9rem; font-weight: 600; color: var(--text); margin-bottom: 8px;
        }
        label .req, .req { color: var(--danger); margin-left: 2px; }
        input[type="text"], select {
            width: 100%; height: 44px; padding: 0 14px;
            background: var(--surface); color: var(--text);
            border: 1px solid var(--gray-40); border-radius: var(--radius);
            font-family: var(--font-base); font-size: 1rem; transition: border-color .2s, box-shadow .2s;
        }
        input::placeholder { color: var(--gray-40); }
        input[readonly] { background: var(--gray-5); cursor: not-allowed; color: var(--text-muted); }
        input:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }

        select {
            -webkit-appearance: none; -moz-appearance: none; appearance: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%231351b4' stroke-width='3'><path d='M6 9l6 6 6-6'/></svg>");
            background-repeat: no-repeat; background-position: right 14px center; padding-right: 40px;
        }

        .field-hint { display: block; font-size: .82rem; color: var(--text-muted); margin-top: 6px; font-weight: 400; }

        .error-message { display: none; color: var(--danger); font-size: .85rem; margin-top: 6px; }
        .error-message::before { content: '\f06a'; font-family: 'Font Awesome 6 Free'; font-weight: 900; margin-right: 6px; }
        .form-group.invalid input,
        .form-group.invalid select { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger); }
        .form-group.invalid .error-message { display: block; animation: shake .3s ease; }

        /* Mensagens padrão gov.br */
        .br-message {
            display: flex; align-items: flex-start; gap: 12px;
            padding: 14px 16px; margin-top: 8px;
            border-radius: var(--radius); border-left: 4px solid var(--warning);
            background: var(--warning-bg); color: var(--text); font-size: .92rem;
        }
        .br-message > i { color: var(--warning); font-size: 1.1rem; margin-top: 2px; flex: 0 0 auto; }
        [data-theme="dark"] .br-message > i { color: var(--gold); }
        [data-theme="dark"] .br-message { border-left-color: var(--gold); }
        .br-message strong { font-weight: 700; }
        .br-message ul { margin: 6px 0 0 18px; }
        .br-message li { margin-bottom: 4px; }
        .br-message.info { border-left-color: var(--info); background: var(--blue-10); }
        .br-message.info > i { color: var(--info); }
        [data-theme="dark"] .br-message.info { background: rgba(90,139,221,.12); border-left-color: var(--accent); }
        [data-theme="dark"] .br-message.info > i { color: var(--accent); }
        .popup .br-message { text-align: left; margin: 0 0 18px; font-size: .88rem; }
        .popup .br-message p { margin: 0; font-size: inherit; }

        /* Checkbox padrão gov.br */
        .checkbox-group { display: flex; flex-direction: column; gap: 12px; }
        .checkbox-item {
            display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px;
            border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface);
            transition: border-color .2s, background .2s;
        }
        .checkbox-item:hover { border-color: var(--accent); background: var(--blue-10); }
        [data-theme="dark"] .checkbox-item:hover { background: rgba(90,139,221,.12); }
        .checkbox-item input[type="checkbox"] {
            width: 22px; height: 22px; margin-top: 1px; accent-color: var(--accent); cursor: pointer; flex: 0 0 auto;
        }
        .checkbox-item label { margin: 0; font-weight: 500; font-size: .95rem; cursor: pointer; }

        /* ===================== UPLOAD DE ANEXOS (PDF) ===================== */
        .upload-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px; margin-top: 18px;
        }
        .upload-group { margin: 0; min-width: 0; }
        .upload-title { display: block; font-size: .95rem; font-weight: 700; color: var(--text); }
        .subitem {
            display: inline-block; background: var(--accent); color: #fff;
            font-size: .8rem; font-weight: 700; border-radius: 100px;
            padding: 1px 10px; margin-right: 6px; vertical-align: 1px;
        }
        .dropzone {
            display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
            margin: 12px 0 0; padding: 24px 16px; text-align: center; cursor: pointer;
            border: 2px dashed var(--gray-40); border-radius: var(--radius);
            background: var(--gray-2); font-weight: 500; font-size: .92rem;
            transition: border-color .2s, background .2s;
        }
        .dropzone i { font-size: 1.8rem; color: var(--accent); margin-bottom: 4px; }
        .dropzone small { color: var(--text-muted); font-size: .8rem; }
        .dropzone:hover, .dropzone.dragover { border-color: var(--accent); background: var(--blue-10); }
        [data-theme="dark"] .dropzone:hover, [data-theme="dark"] .dropzone.dragover { background: rgba(90,139,221,.12); }
        .sr-only:focus-visible + .dropzone { box-shadow: var(--focus); }
        .form-group.invalid .dropzone { border-color: var(--danger); }

        .file-preview {
            display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 10px;
            border: 1px solid var(--border); border-left: 4px solid var(--success);
            border-radius: var(--radius); background: var(--surface);
        }
        .file-preview img {
            width: 58px; max-height: 80px; object-fit: contain; flex: 0 0 auto;
            border: 1px solid var(--border); background: #fff;
        }
        .file-preview .meta { flex: 1; min-width: 0; font-size: .86rem; }
        .file-preview .meta strong { display: block; word-break: break-all; }
        .file-preview .meta span { display: block; color: var(--text-muted); }
        .file-preview .meta .ok { color: var(--success); font-weight: 600; }
        .file-preview .acoes { display: flex; flex-direction: column; gap: 6px; flex: 0 0 auto; }

        .checkbox-item input[type="radio"] {
            width: 22px; height: 22px; margin-top: 1px; accent-color: var(--accent); cursor: pointer; flex: 0 0 auto;
        }
        .extras { margin-top: 26px; padding-top: 18px; border-top: 1px dashed var(--border); }
        .upload-subtitle { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 2px; }
        #anexosExtras { margin-top: 14px; }
        #anexosExtras .upload-group {
            margin-bottom: 16px; padding: 14px; border: 1px solid var(--border); border-radius: var(--radius);
        }
        .extra-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
        .extra-desc { margin-top: 12px; }
        .extra-desc label { font-size: .85rem; margin-bottom: 6px; }

        .acoes-finais { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }

        .download-list { list-style: none; margin: 16px 0; text-align: left; }
        .download-list li {
            display: flex; align-items: center; gap: 12px; padding: 10px 12px;
            background: var(--gray-5); border-radius: 6px; margin-bottom: 8px;
        }
        .download-list li > i { color: var(--accent); font-size: 1.2rem; flex: 0 0 auto; }
        .download-list .nome { flex: 1; min-width: 0; font-size: .88rem; word-break: break-all; }
        .download-list small { display: block; color: var(--text-muted); font-size: .8rem; word-break: normal; margin-top: 2px; }
        .download-list a.br-button { text-decoration: none; flex: 0 0 auto; }

        /* Botões padrão gov.br */
        .button-bar {
            display: flex; justify-content: space-between; gap: 14px;
            margin-top: 28px; padding-top: 22px; border-top: 1px solid var(--border);
        }
        .br-button {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            height: 44px; padding: 0 24px; border: 2px solid transparent; border-radius: 100px;
            font-family: var(--font-base); font-size: .95rem; font-weight: 600; letter-spacing: .2px;
            cursor: pointer; transition: all .2s ease; white-space: nowrap;
        }
        .br-button.small { height: 32px; padding: 0 14px; font-size: .82rem; }
        .br-button.primary { background: var(--accent); color: #fff; }
        .br-button.primary:hover:not(:disabled) { background: var(--accent-hover); transform: translateY(-1px); box-shadow: var(--shadow-2); }
        .br-button.secondary { background: transparent; color: var(--accent); border-color: var(--accent); }
        .br-button.secondary:hover:not(:disabled) { background: var(--blue-10); }
        [data-theme="dark"] .br-button.secondary:hover:not(:disabled) { background: rgba(90,139,221,.14); }
        .br-button:disabled { background: var(--gray-20); color: var(--gray-60); border-color: transparent; cursor: not-allowed; opacity: .8; }

        /* ===================== OVERLAYS / MODAIS ===================== */
        .loading-overlay, .overlay {
            position: fixed; inset: 0; background: rgba(5,29,65,.55); z-index: 1001;
            display: flex; justify-content: center; align-items: center;
            opacity: 0; visibility: hidden; transition: opacity .3s, visibility .3s;
        }
        .loading-overlay p { color: #fff; font-size: 1.1rem; font-weight: 600; display: flex; align-items: center; gap: 12px; }
        .spinner {
            width: 26px; height: 26px; border: 3px solid rgba(255,255,255,.35);
            border-top-color: #fff; border-radius: 50%; animation: spin 1s linear infinite;
        }
        .popup {
            position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(.95);
            background: var(--surface); color: var(--text); border-radius: var(--radius);
            box-shadow: var(--shadow-2); border-top: 4px solid var(--accent);
            padding: 28px 36px; text-align: center; z-index: 1002; max-width: 92vw; width: 480px;
            max-height: 92vh; overflow-y: auto;
            opacity: 0; visibility: hidden; transition: opacity .3s, transform .3s, visibility .3s;
        }
        .popup.show, .overlay.show, .loading-overlay.show { opacity: 1; visibility: visible; }
        .popup.show { transform: translate(-50%,-50%) scale(1); }
        .popup h3 { font-size: 1.3rem; font-weight: 700; color: var(--accent); margin-bottom: 12px; }
        .popup p { font-size: 1rem; margin-bottom: 20px; }
        .popup .btn-row { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
        #fileList { list-style: none; padding: 0; margin: 16px 0; text-align: left; }
        #fileList li {
            font-size: .92rem; padding: 10px 12px 10px 36px; position: relative;
            background: var(--gray-5); border-radius: 6px; margin-bottom: 8px; word-break: break-all;
        }
        #fileList li small { display: block; margin-top: 4px; color: var(--text-muted); word-break: normal; font-size: .82rem; }
        #fileList li::before {
            content: '\f1c1'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
            position: absolute; left: 12px; top: 10px; color: var(--accent);
        }

        /* ===================== RODAPÉ gov.br ===================== */
        footer.br-footer { background: var(--footer-bg); color: #fff; }
        .footer-top { padding: 28px 0; border-bottom: 1px solid rgba(255,255,255,.15); }
        .footer-top .govbr-logo { color: #fff; }
        .footer-top .govbr-logo .dot { color: var(--gold); }
        .footer-sign { font-size: .95rem; color: rgba(255,255,255,.85); margin-top: 6px; }
        .footer-bottom { padding: 18px 0; font-size: .85rem; color: rgba(255,255,255,.8); display: flex; flex-wrap: wrap; gap: 6px 18px; justify-content: space-between; align-items: center; }
        .footer-bottom a { color: #fff; text-decoration: underline; font-weight: 600; }
        .footer-bottom a:hover { color: var(--gold); }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes shake { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
        @keyframes spin { to { transform: rotate(360deg); } }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
        }

        @media (max-width: 768px) {
            .container-lg { padding: 0 16px; }
            .br-card { padding: 22px 18px; }
            .card-head h1 { font-size: 1.3rem; }
            .header-sign { font-size: .9rem; }
            .form-row { flex-direction: column; gap: 0; }
            .button-bar { flex-direction: column-reverse; }
            .button-bar .br-button { width: 100%; }
            .step-name { font-size: .72rem; }
            .step-counter { width: 38px; height: 38px; font-size: .95rem; }
            .stepper-wrapper::before, .stepper-progress { top: 18px; }
            .file-preview { flex-wrap: wrap; }
            .file-preview .acoes { flex-direction: row; width: 100%; }
            .button-bar .acoes-finais { flex-direction: column-reverse; width: 100%; }
            .download-list li { flex-wrap: wrap; }
            .download-list a.br-button { width: 100%; }
        }
    </style>
</head>

<body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>

    <!-- ===================== CABEÇALHO ===================== -->
    <header class="br-header">
        <div class="container-lg">
            <div class="header-top">
                <div class="header-brand">
                    <a class="govbr-logo" href="https://www.gov.br" target="_blank" rel="noopener" aria-label="Portal gov.br">gov<span class="dot">.</span>br</a>
                    <span class="header-divider" aria-hidden="true"></span>
                    <span class="header-sign">Ministério do Esporte</span>
                </div>
                <div class="header-actions">
                    <button class="header-btn" id="themeToggle" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
                        <i class="fas fa-adjust" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="header-bottom">
                <div class="header-title">Gerador de Declarações</div>
                <div class="header-subtitle">Secretaria Executiva — Declarações de Entidades Públicas</div>
            </div>
        </div>
    </header>

    <!-- ===================== BREADCRUMB ===================== -->
    <div class="container-lg">
        <nav class="br-breadcrumb" aria-label="Você está em:">
            <ol>
                <li><a href="https://www.gov.br/esporte" target="_blank" rel="noopener">Início</a></li>
                <li><span class="sep" aria-hidden="true">›</span> Serviços</li>
                <li><span class="sep" aria-hidden="true">›</span> <span aria-current="page">Declaração de Entidade Pública</span></li>
            </ol>
        </nav>
    </div>

    <!-- ===================== CONTEÚDO ===================== -->
    <main id="conteudo" class="container-lg">
        <div class="br-card">
            <div class="card-head">
                <h1>Declaração de Entidade Pública</h1>
                <span class="tag"><i class="fas fa-file-signature" aria-hidden="true"></i>&nbsp; Emissão de documento</span>
            </div>

            <nav class="stepper-nav" aria-label="Etapas do preenchimento">
                <div class="stepper-wrapper">
                    <div class="stepper-progress" aria-hidden="true"></div>
                    <button type="button" class="stepper-item active" data-tab="aba1" aria-label="Etapa 1: Responsável">
                        <span class="step-counter"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
                        <span class="step-name">Responsável</span>
                    </button>
                    <button type="button" class="stepper-item" data-tab="aba2" aria-label="Etapa 2: Entidade">
                        <span class="step-counter"><i class="fa-solid fa-building" aria-hidden="true"></i></span>
                        <span class="step-name">Entidade</span>
                    </button>
                    <button type="button" class="stepper-item" data-tab="aba3" aria-label="Etapa 3: Finalizar">
                        <span class="step-counter"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i></span>
                        <span class="step-name">Finalizar</span>
                    </button>
                </div>
            </nav>

            <form id="declaracoesForm" novalidate>
                <!-- ETAPA 1 -->
                <div id="aba1" class="tab active">
                    <section class="section">
                        <h2>Dados do responsável</h2>
                        <p class="helper">Informe quem assinará as declarações.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="nomeResponsavel">Nome do responsável <span class="req" aria-hidden="true">*</span></label>
                                <input type="text" id="nomeResponsavel" required autocomplete="name" placeholder="Nome completo">
                                <span class="error-message" aria-live="polite">Por favor, digite o nome completo.</span>
                            </div>
                            <div class="form-group">
                                <label for="cargo">Cargo <span class="req" aria-hidden="true">*</span></label>
                                <select id="cargo" required aria-controls="cargoOutroRow">
                                    <option value="Governador(a)">Governador(a)</option>
                                    <option value="Secretário(a) de Estado">Secretário(a) de Estado</option>
                                    <option value="Subsecretário(a) de Esporte">Subsecretário(a) de Esporte</option>
                                    <option value="Secretário(a) de Esporte">Secretário(a) de Esporte</option>
                                    <option value="Prefeito(a) do Município">Prefeito(a) do Município</option>
                                    <option value="Secretário(a) de Finanças">Secretário(a) de Finanças</option>
                                    <option value="Secretário(a) Municipal">Secretário(a) Municipal</option>
                                    <option value="Presidente">Presidente</option>
                                    <option value="Comandante-Geral">Comandante-Geral</option>
                                    <option value="Outros">Outros (especificar)</option>
                                </select>
                                <span class="error-message" aria-live="polite">Por favor, selecione um cargo.</span>
                            </div>
                        </div>

                        <div class="form-row" id="cargoOutroRow" hidden>
                            <div class="form-group full-width">
                                <label for="cargoOutro">Especifique o cargo <span class="req" aria-hidden="true">*</span></label>
                                <input type="text" id="cargoOutro" maxlength="80" autocomplete="organization-title"
                                       placeholder="Ex.: Superintendente, CEO, Diretor-Executivo, Chanceler"
                                       aria-describedby="cargoOutroHint">
                                <span class="field-hint" id="cargoOutroHint">Digite o cargo exatamente como constará na assinatura do documento.</span>
                                <span class="error-message" aria-live="polite">Por favor, informe o cargo do responsável.</span>
                            </div>
                        </div>

                        <div class="br-message warning" role="note">
                            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                            <p><strong>Atenção:</strong> o assinante das declarações deve ser, obrigatoriamente, o mesmo indicado como responsável no PDF do Termo de Referência.</p>
                        </div>
                    </section>
                    <div class="button-bar" style="justify-content: flex-end;">
                        <button type="button" class="br-button primary nav-button" data-next-tab="aba2" disabled>Avançar <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </div>

                <!-- ETAPA 2 -->
                <div id="aba2" class="tab">
                    <section class="section">
                        <h2>Dados da entidade</h2>
                        <p class="helper">Digite o CNPJ para preenchermos automaticamente o endereço.</p>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="cnpj">CNPJ <span class="req" aria-hidden="true">*</span></label>
                                <input type="text" id="cnpj" maxlength="18" inputmode="numeric" placeholder="00.000.000/0000-00" required>
                                <span class="error-message" aria-live="polite">Por favor, digite um CNPJ válido.</span>
                            </div>
                            <div class="form-group">
                                <label for="cep">CEP</label>
                                <input type="text" id="cep" maxlength="9" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">CEP não encontrado.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="endereco">Endereço (rua, número, bairro)</label>
                                <input type="text" id="endereco" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Endereço não encontrado.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="complemento">Complemento</label>
                                <input type="text" id="complemento" autocomplete="address-line2" placeholder="Ex.: Bloco A, Sala 101">
                            </div>
                            <div class="form-group">
                                <label for="cidadeUF">Cidade/UF</label>
                                <input type="text" id="cidadeUF" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Cidade/UF não encontrada.</span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="nomeEstadoMunicipio">Nome do estado ou município</label>
                                <input type="text" id="nomeEstadoMunicipio" placeholder="Preenchido pelo CNPJ" readonly required>
                                <span class="error-message" aria-live="polite">Nome não encontrado.</span>
                            </div>
                        </div>
                    </section>

                    <section class="section">
                        <h2>Origem do recurso</h2>
                        <p class="helper">Selecione a classificação aplicável.</p>
                        <div class="checkbox-group" id="declaracaoTipoGroup">
                            <div class="checkbox-item">
                                <input type="checkbox" id="emenda" name="declaracaoTipo" value="20JP_00SL_emenda">
                                <label for="emenda">20JP - 00SL — Emenda Individual e Bancada</label>
                            </div>
                            <div class="checkbox-item">
                                <input type="checkbox" id="comissao" name="declaracaoTipo" value="20JP_00SL_comissao">
                                <label for="comissao">20JP - 00SL — Discricionário e Comissão</label>
                            </div>
                        </div>
                    </section>

                    <div class="button-bar">
                        <button type="button" class="br-button secondary nav-button" data-prev-tab="aba1"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar</button>
                        <button type="button" class="br-button primary nav-button" data-next-tab="aba3" disabled>Avançar <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                    </div>
                </div>

                <!-- ETAPA 3 -->
                <div id="aba3" class="tab">
                    <section class="section" id="modoGeracaoSection">
                        <h2>O que você quer gerar?</h2>
                        <div class="checkbox-group" role="radiogroup" aria-label="Tipo de geração">
                            <div class="checkbox-item">
                                <input type="radio" name="modoGeracao" id="modoCompleto" value="completo" checked>
                                <label for="modoCompleto">Declarações completas
                                    <span class="field-hint">Gera todas as declarações aplicáveis e, quando exigido, o arquivo de anexos.</span>
                                </label>
                            </div>
                            <div class="checkbox-item">
                                <input type="radio" name="modoGeracao" id="modoAnexos" value="anexos">
                                <label for="modoAnexos">Somente o arquivo de anexos (complementação)
                                    <span class="field-hint">Use quando a SNEAELIS pedir documentos que faltaram. Gera apenas o PDF de anexos com o que você enviar agora — as declarações não são refeitas.</span>
                                </label>
                            </div>
                        </div>
                    </section>

                    <section class="section" id="configuracoesSection">
                        <h2>Configuração das declarações</h2>
                        <p class="helper">Marque as opções que correspondem à realidade do seu município.</p>
                        <div class="checkbox-group" id="configuracoesGroup">
                            <!-- Preenchido dinamicamente conforme a origem do recurso -->
                        </div>
                    </section>

                    <!-- ANEXOS DA DECLARAÇÃO DE PRECATÓRIOS (exibido quando NÃO houver certidões TJ/TRT/TRF) -->
                    <section class="section" id="anexosPrecatoriosSection" aria-labelledby="anexosTitulo" hidden>
                        <h2 id="anexosTitulo">Anexos da declaração de precatórios judiciais</h2>
                        <p class="helper" id="anexosHelper">
                            Como o município <strong>não apresentará</strong> as certidões do TJ, do TRT e do TRF, a Declaração de
                            Regularidade no Pagamento de Precatórios Judiciais só é aceita acompanhada dos dois documentos abaixo
                            (art. 29, inciso II, c/c § 6º, da Portaria Conjunta MGI/MF/CGU nº 33/2023).
                        </p>

                        <div class="br-message info" role="note">
                            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                            <div>
                                <p><strong>Como preparar os arquivos</strong></p>
                                <ul>
                                    <li>Formato aceito: <strong>somente PDF (.pdf)</strong>. Fotos (JPG/PNG) e arquivos do Word devem ser convertidos antes — use “Imprimir &gt; Salvar como PDF” ou “Exportar como PDF”.</li>
                                    <li>Limite por arquivo: <strong>10 MB</strong> e até <strong>20 páginas</strong>.</li>
                                    <li>O PDF não pode estar protegido por senha e precisa estar legível (para digitalizações, use de 150 a 300 dpi).</li>
                                    <li>Os anexos <strong>não entram no arquivo das declarações</strong>: eles são gerados em um <strong>terceiro PDF, separado</strong> (“Anexos_Declaração_de_Precatórios_Judiciais”), com página de índice e os subitens <strong>1.1</strong> e <strong>1.2</strong>.</li>
                                    <li>Cada página do PDF enviado é inserida <strong>como imagem</strong> nesse arquivo de anexos, com o cabeçalho da entidade e a identificação do subitem.</li>
                                    <li>Se a SNEAELIS pedir documentos depois, volte aqui, escolha <strong>“Somente o arquivo de anexos”</strong> no topo desta etapa e envie apenas o que falta.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="upload-grid">
                            <div class="form-group upload-group" data-anexo="remessa">
                                <span class="upload-title"><span class="subitem">1.1</span>Comprovante de remessa ao Tribunal de Contas <span class="req req-fixo" aria-hidden="true">*</span></span>
                                <span class="field-hint">Protocolo, recibo ou e-mail de envio da declaração ao Tribunal de Contas competente (TCE/TCM), com a data visível.</span>
                                <input type="file" id="anexoRemessa" class="sr-only" accept="application/pdf,.pdf" aria-describedby="erroAnexoRemessa">
                                <label class="dropzone" for="anexoRemessa">
                                    <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                                    <span><strong>Clique para selecionar</strong> ou arraste o PDF aqui</span>
                                    <small>Somente .pdf, até 10 MB</small>
                                </label>
                                <div class="file-preview" hidden></div>
                                <span class="error-message" id="erroAnexoRemessa" aria-live="polite"></span>
                            </div>

                            <div class="form-group upload-group" data-anexo="impossibilidade">
                                <span class="upload-title"><span class="subitem">1.2</span>Comprovante de impossibilidade de emissão das certidões <span class="req req-fixo" aria-hidden="true">*</span></span>
                                <span class="field-hint">Documento que comprove que as certidões do TJ, do TRT e/ou do TRF não puderam ser emitidas (tela de erro, resposta do tribunal, ofício etc.).</span>
                                <input type="file" id="anexoImpossibilidade" class="sr-only" accept="application/pdf,.pdf" aria-describedby="erroAnexoImpossibilidade">
                                <label class="dropzone" for="anexoImpossibilidade">
                                    <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                                    <span><strong>Clique para selecionar</strong> ou arraste o PDF aqui</span>
                                    <small>Somente .pdf, até 10 MB</small>
                                </label>
                                <div class="file-preview" hidden></div>
                                <span class="error-message" id="erroAnexoImpossibilidade" aria-live="polite"></span>
                            </div>
                        </div>

                        <div class="extras">
                            <h3 class="upload-subtitle">Outros anexos (opcional)</h3>
                            <span class="field-hint">Documentos adicionais pedidos pela SNEAELIS. Eles entram no mesmo arquivo de anexos, numerados a partir de 1.3.</span>
                            <div id="anexosExtras"></div>
                            <button type="button" class="br-button secondary small" id="addAnexoExtra"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar outro anexo</button>
                        </div>
                    </section>

                    <div class="button-bar">
                        <button type="button" class="br-button secondary nav-button" data-prev-tab="aba2"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar</button>
                        <div class="acoes-finais">
                            <button type="button" class="br-button secondary" id="reabrirArquivosBtn" hidden><i class="fa-solid fa-folder-open" aria-hidden="true"></i> Arquivos gerados</button>
                            <button type="submit" class="br-button primary" id="gerarPDFBtn"><i class="fa-solid fa-check" aria-hidden="true"></i> Gerar PDF</button>
                        </div>
                    </div>
                </div>
            </form>

            <div id="loadingMessage" class="loading-overlay" aria-hidden="true" role="status">
                <p>Aguarde... <span class="spinner" aria-hidden="true"></span></p>
            </div>
        </div>
    </main>

    <!-- ===================== POPUPS ===================== -->
    <div id="successPopup" class="popup" role="dialog" aria-modal="true" aria-labelledby="sucessoTitulo" aria-hidden="true">
        <h3 id="sucessoTitulo"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Documentos prontos</h3>
        <p>Baixe cada arquivo no botão ao lado do nome ou todos juntos em um .zip.</p>
        <ul id="downloadList" class="download-list"></ul>
        <div class="btn-row">
            <button class="br-button secondary" id="closePopupBtn" type="button">Fechar</button>
            <button class="br-button primary" id="baixarZipBtn" type="button"><i class="fa-solid fa-file-zipper" aria-hidden="true"></i> Baixar todos (.zip)</button>
        </div>
    </div>

    <div id="overlay" class="overlay" aria-hidden="true"></div>

    <div id="confirmationPopup" class="popup" role="alertdialog" aria-modal="true" aria-labelledby="confTitle" aria-hidden="true">
        <h3 id="confTitle">Arquivos a serem baixados</h3>
        <p>Os seguintes documentos serão gerados:</p>
        <ul id="fileList"></ul>
        <div class="br-message warning" role="note">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <p>Confirme que <strong id="assinanteResumo">o assinante</strong> é o mesmo responsável indicado no PDF do Termo de Referência.</p>
        </div>
        <div class="btn-row">
            <button class="br-button secondary" id="cancelPopupBtn" type="button">Cancelar</button>
            <button class="br-button primary" id="confirmDownloadBtn" type="button"><i class="fa-solid fa-check" aria-hidden="true"></i> Ciente</button>
        </div>
    </div>

    <!-- ===================== RODAPÉ ===================== -->
    <footer class="br-footer">
        <div class="container-lg">
            <div class="footer-top">
                <a class="govbr-logo" href="https://www.gov.br" target="_blank" rel="noopener" aria-label="Portal gov.br">gov<span class="dot">.</span>br</a>
                <div class="footer-sign">Ministério do Esporte — Secretaria Executiva</div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 Ministério do Esporte. Todos os direitos reservados.</span>
                <span><a href="https://www.esporte.gov.br" target="_blank" rel="noopener noreferrer">Acesse o portal do Ministério do Esporte</a></span>
            </div>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <!-- pdf.js: lê o PDF anexado e converte cada página em imagem -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <!-- JSZip: botão "Baixar todos (.zip)" -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- UI and Form Handling ---
        const form = document.getElementById('declaracoesForm');
        const themeToggle = document.getElementById('themeToggle');
        const cnpjInput = document.getElementById('cnpj');
        const cargoSelect = document.getElementById('cargo');
        const cargoOutroRow = document.getElementById('cargoOutroRow');
        const cargoOutroInput = document.getElementById('cargoOutro');
        const navButtons = document.querySelectorAll('.nav-button');
        const stepperItems = document.querySelectorAll('.stepper-item');
        const progress = document.querySelector('.stepper-progress');
        const successPopup = document.getElementById('successPopup');
        const closePopupBtn = document.getElementById('closePopupBtn');
        const overlay = document.getElementById('overlay');
        const loadingMessage = document.getElementById('loadingMessage');
        const anexosSection = document.getElementById('anexosPrecatoriosSection');
        const configuracoesGroupEl = document.getElementById('configuracoesGroup');
        const configuracoesSection = document.getElementById('configuracoesSection');
        const anexosHelper = document.getElementById('anexosHelper');
        const gerarPDFBtn = document.getElementById('gerarPDFBtn');
        const baixarZipBtn = document.getElementById('baixarZipBtn');
        const reabrirArquivosBtn = document.getElementById('reabrirArquivosBtn');
        const modoAnexosApenas = () => !!document.getElementById('modoAnexos')?.checked;
        const tabs = ['aba1', 'aba2', 'aba3'];
        let nomeEntidadeGlobal = '';

        // pdf.js — worker do mesmo CDN/versão
        if (window.pdfjsLib) {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        const applyTheme = (theme) => {
            document.body.dataset.theme = theme;
            themeToggle.setAttribute('aria-label', `Mudar para tema ${theme === 'light' ? 'escuro' : 'claro'}`);
        };

        themeToggle.addEventListener('click', () => {
            const currentTheme = document.body.dataset.theme === 'light' ? 'dark' : 'light';
            try { localStorage.setItem('theme', currentTheme); } catch (e) { /* armazenamento indisponível */ }
            applyTheme(currentTheme);
        });

        let temaSalvo = null;
        try { temaSalvo = localStorage.getItem('theme'); } catch (e) { /* armazenamento indisponível */ }
        applyTheme(temaSalvo || 'light');

        const updateStepper = (currentTabIndex) => {
            stepperItems.forEach((item, index) => {
                const counter = item.querySelector('.step-counter');
                item.classList.remove('active', 'completed');
                const icons = ['<i class="fa-solid fa-user" aria-hidden="true"></i>', '<i class="fa-solid fa-building" aria-hidden="true"></i>', '<i class="fa-solid fa-file-pdf" aria-hidden="true"></i>'];
                if (index < currentTabIndex) {
                    item.classList.add('completed');
                    counter.innerHTML = '<i class="fa-solid fa-check" aria-hidden="true"></i>';
                } else if (index === currentTabIndex) {
                    item.classList.add('active');
                    counter.innerHTML = icons[index];
                } else {
                    counter.innerHTML = icons[index];
                }
            });
            const progressWidth = (currentTabIndex / (stepperItems.length - 1)) * 88;
            progress.style.width = `${progressWidth}%`;
        };

        const showTab = (tabId) => {
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            document.getElementById(tabId)?.classList.add('active');
            const currentTabIndex = tabs.indexOf(tabId);
            updateStepper(currentTabIndex);
            if (tabId === 'aba3') {
                updateConfiguracoesCheckboxes();
            }
        };

        stepperItems.forEach(item => {
            item.addEventListener('click', () => {
                if (item.classList.contains('completed')) {
                    showTab(item.dataset.tab);
                }
            });
        });

        navButtons.forEach(button => {
            button.addEventListener('click', () => {
                const targetTabId = button.dataset.nextTab || button.dataset.prevTab;
                if (button.dataset.nextTab && !validateTab(button.closest('.tab').id)) {
                    return;
                }
                showTab(targetTabId);
            });
        });

        const validateInput = (input) => {
            const formGroup = input.closest('.form-group');
            let isValid = input.checkValidity() && input.value.trim() !== '';
            if (input.id === 'nomeResponsavel') {
                const nameValue = input.value.trim();
                const errorMessage = formGroup.querySelector('.error-message');
                if (nameValue.split(' ').length < 2) {
                    isValid = false;
                    if (errorMessage) errorMessage.textContent = 'Por favor, digite o nome completo (nome e sobrenome).';
                } else if (errorMessage) {
                    errorMessage.textContent = '';
                }
            }
            if (!isValid) {
                formGroup.classList.add('invalid');
                return false;
            }
            formGroup.classList.remove('invalid');
            return true;
        };

        const validateTab = (tabId) => {
            const tab = document.getElementById(tabId);
            if (!tab) return false;
            let isTabValid = true;
            if (tabId === 'aba1' || tabId === 'aba2') {
                const inputs = tab.querySelectorAll('input[required], select[required]');
                inputs.forEach(input => {
                    if (!validateInput(input)) isTabValid = false;
                });
            }
            if (tabId === 'aba3' && !validarAnexos()) isTabValid = false;
            const nextButton = tab.querySelector('.nav-button[data-next-tab]');
            if (nextButton) nextButton.disabled = !isTabValid;
            return isTabValid;
        };

        // --- Cargo "Outros": exibe campo de digitação livre ---
        const getCargoInformado = () => {
            if (cargoSelect.value === 'Outros') {
                return cargoOutroInput.value.trim().replace(/\s+/g, ' ');
            }
            return cargoSelect.value;
        };

        const toggleCargoOutro = () => {
            const isOutros = cargoSelect.value === 'Outros';
            cargoOutroRow.hidden = !isOutros;
            cargoOutroInput.required = isOutros;
            if (isOutros) {
                cargoOutroInput.focus();
            } else {
                cargoOutroInput.value = '';
                cargoOutroInput.closest('.form-group').classList.remove('invalid');
            }
            validateTab('aba1');
        };

        cargoSelect.addEventListener('change', toggleCargoOutro);

        form.addEventListener('input', (e) => {
            if (e.target.hasAttribute('required')) {
                validateTab(e.target.closest('.tab').id);
            }
        });

        cnpjInput.addEventListener('input', (e) => {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 14) value = value.substring(0, 14);
            value = value.replace(/^(\d{2})(\d)/, '$1.$2');
            value = value.replace(/^(\d{2})\.(\d{3})(\d)/, '$1.$2.$3');
            value = value.replace(/\.(\d{3})(\d)/, '.$1/$2');
            value = value.replace(/(\d{4})(\d)/, '$1-$2');
            e.target.value = value;
            if (value.length === 18) fetchCNPJData(value.replace(/\D/g, ''));
        });

        // --- Busca de CNPJ com fallback entre provedores ---
        const PROVEDORES_CNPJ = [
            {
                nome: 'BrasilAPI',
                url: (c) => `https://brasilapi.com.br/api/cnpj/v1/${c}`,
                normalizar: (d) => ({
                    razao: d.razao_social, cep: d.cep, logradouro: d.logradouro,
                    numero: d.numero, bairro: d.bairro, municipio: d.municipio, uf: d.uf
                })
            },
            {
                nome: 'Minha Receita',
                url: (c) => `https://minhareceita.org/${c}`,
                normalizar: (d) => ({
                    razao: d.razao_social, cep: d.cep, logradouro: d.logradouro,
                    numero: d.numero, bairro: d.bairro, municipio: d.municipio, uf: d.uf
                })
            },
            {
                nome: 'CNPJ.ws',
                url: (c) => `https://publica.cnpj.ws/cnpj/${c}`,
                normalizar: (d) => {
                    const e = d.estabelecimento || {};
                    return {
                        razao: d.razao_social, cep: e.cep,
                        logradouro: [e.tipo_logradouro, e.logradouro].filter(Boolean).join(' '),
                        numero: e.numero, bairro: e.bairro,
                        municipio: e.cidade?.nome, uf: e.estado?.sigla
                    };
                }
            }
        ];

        const camposEndereco = ['cep', 'endereco', 'cidadeUF', 'nomeEstadoMunicipio'];

        const definirModoManual = (manual) => {
            camposEndereco.forEach(id => {
                const el = document.getElementById(id);
                el.readOnly = !manual;
                el.placeholder = manual ? 'Preencha manualmente' : 'Preenchido pelo CNPJ';
            });
        };

        const buscarEmProvedores = async (cnpj) => {
            for (const p of PROVEDORES_CNPJ) {
                try {
                    const resp = await fetch(p.url(cnpj), { signal: AbortSignal.timeout(8000) });
                    if (resp.status === 404) continue;
                    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                    const dados = p.normalizar(await resp.json());
                    if (dados.razao || dados.municipio) return dados;
                } catch (err) {
                    console.warn(`Falha no provedor ${p.nome}:`, err.message);
                }
            }
            return null;
        };

        const fetchCNPJData = async (cnpj) => {
            toggleLoading(true, 'Buscando dados do CNPJ...');
            const formGroup = cnpjInput.closest('.form-group');
            const errorSpan = formGroup.querySelector('.error-message');
            formGroup.classList.remove('invalid');

            try {
                const d = await buscarEmProvedores(cnpj);

                if (!d) {
                    nomeEntidadeGlobal = '';
                    camposEndereco.forEach(id => document.getElementById(id).value = '');
                    definirModoManual(true);
                    formGroup.classList.add('invalid');
                    errorSpan.textContent = 'Não foi possível consultar o CNPJ agora. Preencha o endereço manualmente abaixo.';
                    document.getElementById('cep').focus();
                    return;
                }

                definirModoManual(false);
                const cepLimpo = String(d.cep || '').replace(/\D/g, '');
                nomeEntidadeGlobal = d.razao || d.municipio || '';
                document.getElementById('cep').value = cepLimpo.replace(/(\d{5})(\d{3})/, '$1-$2');
                document.getElementById('endereco').value = [d.logradouro, d.numero, d.bairro].filter(Boolean).join(', ');
                document.getElementById('cidadeUF').value = `${d.municipio || ''}/${d.uf || ''}`;
                document.getElementById('nomeEstadoMunicipio').value = d.razao || d.municipio || '';
            } finally {
                toggleLoading(false);
                validateTab('aba2');
            }
        };

        const toggleLoading = (show, text = 'Aguarde um momento...') => {
            const p = loadingMessage.querySelector('p');
            if (p) p.firstChild.textContent = text + ' ';
            loadingMessage.classList.toggle('show', show);
        };

        const showPopup = () => {
            successPopup.classList.add('show');
            overlay.classList.add('show');
        };

        const closePopup = () => {
            successPopup.classList.remove('show');
            overlay.classList.remove('show');
        };

        closePopupBtn.addEventListener('click', closePopup);
        reabrirArquivosBtn.addEventListener('click', showPopup);

        // =====================================================================
        // DOWNLOADS: nada é baixado automaticamente. Os PDFs são gerados em
        // memória e cada um ganha um botão "Baixar" (clique do usuário), o que
        // evita o bloqueio de "vários downloads" dos navegadores.
        // =====================================================================
        let urlsGerados = [];
        let arquivosGerados = [];
        let nomeZip = 'Documentos.zip';

        const mostrarResultados = (arquivos, zipNome) => {
            urlsGerados.forEach(u => URL.revokeObjectURL(u));
            urlsGerados = [];
            arquivosGerados = arquivos;
            nomeZip = zipNome;

            const lista = document.getElementById('downloadList');
            lista.innerHTML = '';
            arquivos.forEach(a => {
                const url = URL.createObjectURL(a.blob);
                urlsGerados.push(url);
                const li = document.createElement('li');
                li.innerHTML = `
                    <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
                    <span class="nome">${escapeHtml(a.nome)}${a.detalhe ? `<small>${escapeHtml(a.detalhe)}</small>` : ''}</span>
                    <a class="br-button primary small" href="${url}" download="${escapeHtml(a.nome)}"><i class="fa-solid fa-download" aria-hidden="true"></i> Baixar</a>`;
                lista.appendChild(li);
            });
            baixarZipBtn.hidden = arquivos.length < 2;
            reabrirArquivosBtn.hidden = false;
            showPopup();
        };

        baixarZipBtn.addEventListener('click', async () => {
            if (!window.JSZip) {
                alert('Não foi possível carregar o compactador. Baixe os arquivos um por um.');
                return;
            }
            const zip = new JSZip();
            arquivosGerados.forEach(a => zip.file(a.nome, a.blob));
            const blob = await zip.generateAsync({ type: 'blob' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = nomeZip;
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTimeout(() => URL.revokeObjectURL(url), 15000);
        });

        // =====================================================================
        // ANEXOS EM PDF — comprovante de remessa e de impossibilidade
        // Obrigatórios quando "Discricionário e Comissão" estiver marcado e o
        // município NÃO apresentar as certidões do TJ, TRT e TRF.
        // =====================================================================
        const MAX_ANEXO_MB = 10;
        const MAX_ANEXO_PAGINAS = 20;

        const ANEXOS_PRECATORIOS = [
            {
                chave: 'remessa',
                subnumero: '1.1',
                inputId: 'anexoRemessa',
                rotulo: 'Comprovante de remessa',
                titulo: 'COMPROVANTE DE REMESSA DA DECLARAÇÃO AO TRIBUNAL DE CONTAS'
            },
            {
                chave: 'impossibilidade',
                subnumero: '1.2',
                inputId: 'anexoImpossibilidade',
                rotulo: 'Comprovante de impossibilidade',
                titulo: 'COMPROVANTE DE IMPOSSIBILIDADE DE EMISSÃO DAS CERTIDÕES JUDICIAIS (TJ, TRT E TRF)'
            }
        ];

        const anexosState = {}; // { remessa: { nomeArquivo, tamanho, paginas: [{dataUrl, width, height}] }, ... }

        const precisaAnexosPrecatorios = () =>
            !!document.getElementById('comissao')?.checked &&
            !document.getElementById('apresentaraCertidoes')?.checked;

        const grupoAnexo = (cfg) => document.querySelector(`.upload-group[data-anexo="${cfg.chave}"]`);

        const definirErroAnexo = (cfg, mensagem) => {
            const grupo = grupoAnexo(cfg);
            grupo.classList.toggle('invalid', !!mensagem);
            grupo.querySelector('.error-message').textContent = mensagem || '';
        };

        const formatarTamanho = (bytes) => bytes < 1024 * 1024
            ? `${Math.max(1, Math.round(bytes / 1024))} KB`
            : `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')} MB`;

        const limparAnexo = (cfg) => {
            delete anexosState[cfg.chave];
            const grupo = grupoAnexo(cfg);
            document.getElementById(cfg.inputId).value = '';
            const preview = grupo.querySelector('.file-preview');
            preview.innerHTML = '';
            preview.hidden = true;
            grupo.querySelector('.dropzone').hidden = false;
        };

        const exibirPreviewAnexo = (cfg) => {
            const a = anexosState[cfg.chave];
            const grupo = grupoAnexo(cfg);
            const preview = grupo.querySelector('.file-preview');
            const n = a.paginas.length;
            preview.innerHTML = `
                <img src="${a.paginas[0].dataUrl}" alt="Primeira página de ${escapeHtml(a.nomeArquivo)}">
                <div class="meta">
                    <strong>${escapeHtml(a.nomeArquivo)}</strong>
                    <span>${n} ${n === 1 ? 'página' : 'páginas'}, ${formatarTamanho(a.tamanho)}</span>
                    <span class="ok"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Será incluído no arquivo de anexos</span>
                </div>
                <div class="acoes">
                    <button type="button" class="br-button secondary small" data-acao="substituir">Substituir</button>
                    <button type="button" class="br-button secondary small" data-acao="remover">Remover</button>
                </div>`;
            preview.hidden = false;
            grupo.querySelector('.dropzone').hidden = true;
        };

        // Converte cada página do PDF em imagem JPEG (≈150 dpi)
        const renderizarPdfEmImagens = async (file) => {
            const dados = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: dados }).promise;
            try {
                if (pdf.numPages < 1) {
                    const e = new Error('PDF sem páginas'); e.code = 'SEM_PAGINAS'; throw e;
                }
                if (pdf.numPages > MAX_ANEXO_PAGINAS) {
                    const e = new Error('Páginas demais'); e.code = 'EXCESSO_PAGINAS'; e.total = pdf.numPages; throw e;
                }
                const paginas = [];
                for (let i = 1; i <= pdf.numPages; i++) {
                    const page = await pdf.getPage(i);
                    const base = page.getViewport({ scale: 1 });
                    const scale = Math.min(2.5, 1600 / Math.max(base.width, base.height)); // ~140 dpi em A4
                    const viewport = page.getViewport({ scale });
                    const canvas = document.createElement('canvas');
                    canvas.width = Math.floor(viewport.width);
                    canvas.height = Math.floor(viewport.height);
                    const ctx = canvas.getContext('2d');
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    await page.render({ canvasContext: ctx, viewport }).promise;
                    paginas.push({ dataUrl: canvas.toDataURL('image/jpeg', 0.85), width: canvas.width, height: canvas.height });
                    page.cleanup();
                }
                return paginas;
            } finally {
                pdf.destroy();
            }
        };

        const mensagemErroPdf = (err) => {
            if (err?.name === 'PasswordException') return 'Este PDF está protegido por senha. Remova a proteção e envie novamente.';
            if (err?.code === 'EXCESSO_PAGINAS') return `O PDF tem ${err.total} páginas. O limite é ${MAX_ANEXO_PAGINAS} páginas por arquivo.`;
            if (err?.code === 'SEM_PAGINAS') return 'O PDF está vazio. Envie um arquivo com ao menos uma página.';
            if (err?.name === 'InvalidPDFException') return 'O arquivo não é um PDF válido ou está corrompido. Gere o PDF novamente e envie outra vez.';
            return 'Não foi possível ler este PDF. Gere o arquivo novamente (“Salvar como PDF”) e envie outra vez.';
        };

        const processarArquivoAnexo = async (cfg, file) => {
            definirErroAnexo(cfg, '');
            if (!file) return;

            const ehPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name);
            if (!ehPdf) {
                limparAnexo(cfg);
                definirErroAnexo(cfg, `Formato não aceito (“${file.name}”). Envie somente arquivo PDF (.pdf).`);
                return;
            }
            if (file.size > MAX_ANEXO_MB * 1024 * 1024) {
                limparAnexo(cfg);
                definirErroAnexo(cfg, `O arquivo tem ${formatarTamanho(file.size)}. O limite é ${MAX_ANEXO_MB} MB; reduza ou comprima o PDF.`);
                return;
            }
            if (typeof pdfjsLib === 'undefined') {
                limparAnexo(cfg);
                definirErroAnexo(cfg, 'O leitor de PDF não carregou. Verifique a conexão e recarregue a página.');
                return;
            }

            toggleLoading(true, 'Lendo o PDF anexado...');
            try {
                const paginas = await renderizarPdfEmImagens(file);
                anexosState[cfg.chave] = { nomeArquivo: file.name, tamanho: file.size, paginas };
                exibirPreviewAnexo(cfg);
            } catch (err) {
                console.error('Erro ao ler PDF anexado:', err);
                limparAnexo(cfg);
                definirErroAnexo(cfg, mensagemErroPdf(err));
            } finally {
                toggleLoading(false);
            }
        };

        // --- Liga upload, arrastar-e-soltar e botões de um slot de anexo ---
        const vincularSlotAnexo = (cfg) => {
            const input = document.getElementById(cfg.inputId);
            const grupo = grupoAnexo(cfg);
            const dropzone = grupo.querySelector('.dropzone');

            input.addEventListener('change', () => processarArquivoAnexo(cfg, input.files?.[0]));

            ['dragenter', 'dragover'].forEach(ev => dropzone.addEventListener(ev, (e) => {
                e.preventDefault();
                dropzone.classList.add('dragover');
            }));
            ['dragleave', 'drop'].forEach(ev => dropzone.addEventListener(ev, (e) => {
                e.preventDefault();
                dropzone.classList.remove('dragover');
            }));
            dropzone.addEventListener('drop', (e) => {
                const file = e.dataTransfer?.files?.[0];
                if (file) processarArquivoAnexo(cfg, file);
            });

            grupo.addEventListener('click', (e) => {
                const botao = e.target.closest('[data-acao]');
                if (!botao) return;
                if (botao.dataset.acao === 'remover') {
                    limparAnexo(cfg);
                    input.focus();
                } else if (botao.dataset.acao === 'substituir') {
                    input.click();
                } else if (botao.dataset.acao === 'excluir') {
                    excluirAnexoExtra(cfg);
                }
            });
        };

        ANEXOS_PRECATORIOS.forEach(vincularSlotAnexo);

        // --- Anexos complementares (1.3, 1.4, ...) ---
        let anexosExtras = [];
        let contadorExtras = 0;
        const todosSlots = () => [...ANEXOS_PRECATORIOS, ...anexosExtras];
        const descricaoExtra = (cfg) => (document.getElementById(`${cfg.inputId}Desc`)?.value || '').trim().replace(/\s+/g, ' ');
        const tituloSlot = (cfg) => cfg.extra ? (descricaoExtra(cfg).toUpperCase() || 'DOCUMENTO COMPLEMENTAR') : cfg.titulo;

        const renumerarExtras = () => {
            anexosExtras.forEach((cfg, i) => {
                cfg.subnumero = `1.${i + 3}`;
                cfg.rotulo = `Anexo ${cfg.subnumero}`;
                const badge = grupoAnexo(cfg)?.querySelector('.subitem');
                if (badge) badge.textContent = cfg.subnumero;
            });
        };

        const adicionarAnexoExtra = () => {
            contadorExtras++;
            const cfg = { chave: `extra${contadorExtras}`, inputId: `anexoExtra${contadorExtras}`, extra: true, subnumero: '', rotulo: '' };
            const div = document.createElement('div');
            div.className = 'form-group upload-group';
            div.dataset.anexo = cfg.chave;
            div.innerHTML = `
                <div class="extra-head">
                    <span class="upload-title"><span class="subitem"></span>Anexo complementar</span>
                    <button type="button" class="br-button secondary small" data-acao="excluir"><i class="fa-solid fa-trash" aria-hidden="true"></i> Excluir</button>
                </div>
                <div class="extra-desc">
                    <label for="${cfg.inputId}Desc">Descrição do documento <span class="req" aria-hidden="true">*</span></label>
                    <input type="text" id="${cfg.inputId}Desc" maxlength="150" placeholder="Ex.: Ofício nº 123/2026 – resposta do TJ">
                </div>
                <input type="file" id="${cfg.inputId}" class="sr-only" accept="application/pdf,.pdf">
                <label class="dropzone" for="${cfg.inputId}">
                    <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                    <span><strong>Clique para selecionar</strong> ou arraste o PDF aqui</span>
                    <small>Somente .pdf, até 10 MB</small>
                </label>
                <div class="file-preview" hidden></div>
                <span class="error-message" aria-live="polite"></span>`;
            document.getElementById('anexosExtras').appendChild(div);
            anexosExtras.push(cfg);
            renumerarExtras();
            vincularSlotAnexo(cfg);
            document.getElementById(`${cfg.inputId}Desc`).addEventListener('input', () => {
                if (anexosState[cfg.chave]) definirErroAnexo(cfg, '');
            });
            document.getElementById(`${cfg.inputId}Desc`).focus();
        };

        const excluirAnexoExtra = (cfg) => {
            delete anexosState[cfg.chave];
            grupoAnexo(cfg)?.remove();
            anexosExtras = anexosExtras.filter(c => c !== cfg);
            renumerarExtras();
            document.getElementById('addAnexoExtra').focus();
        };

        document.getElementById('addAnexoExtra').addEventListener('click', adicionarAnexoExtra);

        // Anexos com arquivo, na ordem 1.1, 1.2, 1.3...
        const anexosSelecionados = () => todosSlots()
            .filter(cfg => anexosState[cfg.chave])
            .map(cfg => ({
                subnumero: cfg.subnumero,
                titulo: tituloSlot(cfg),
                nomeArquivo: anexosState[cfg.chave].nomeArquivo,
                paginas: anexosState[cfg.chave].paginas
            }));

        const validarAnexos = () => {
            if (anexosSection.hidden) return true;
            const modoAnexos = modoAnexosApenas();
            let ok = true;
            let primeiro = null;
            const marcar = (cfg, msg) => {
                definirErroAnexo(cfg, msg);
                ok = false;
                if (!primeiro) primeiro = grupoAnexo(cfg);
            };

            if (!modoAnexos) {
                ANEXOS_PRECATORIOS.forEach(cfg => {
                    if (!anexosState[cfg.chave]) marcar(cfg, `Anexe o ${cfg.rotulo.toLowerCase()} em PDF para continuar.`);
                });
            }
            anexosExtras.forEach(cfg => {
                if (!anexosState[cfg.chave]) marcar(cfg, 'Anexe o PDF deste item ou clique em Excluir.');
                else if (!descricaoExtra(cfg)) marcar(cfg, 'Informe a descrição do documento.');
            });
            if (modoAnexos && ok && !todosSlots().some(cfg => anexosState[cfg.chave])) {
                marcar(ANEXOS_PRECATORIOS[0], 'Anexe ao menos um documento em PDF (1.1, 1.2 ou um anexo complementar).');
            }
            if (primeiro) primeiro.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return ok;
        };

        const TEXTO_HELPER_COMPLETO = anexosHelper.innerHTML;
        const TEXTO_HELPER_COMPLEMENTO = `Envie <strong>somente os documentos que estão faltando</strong>. Será gerado apenas o PDF de anexos, mantendo a numeração:
            1.1 para o comprovante de remessa, 1.2 para o comprovante de impossibilidade e 1.3 em diante para documentos complementares.
            As declarações não são geradas novamente.`;

        const atualizarSecaoAnexos = () => {
            const modoAnexos = modoAnexosApenas();
            configuracoesSection.hidden = modoAnexos;
            const mostrar = modoAnexos || precisaAnexosPrecatorios();
            anexosSection.hidden = !mostrar;
            document.querySelectorAll('.req-fixo').forEach(el => { el.hidden = modoAnexos; });
            anexosHelper.innerHTML = modoAnexos ? TEXTO_HELPER_COMPLEMENTO : TEXTO_HELPER_COMPLETO;
            gerarPDFBtn.innerHTML = modoAnexos
                ? '<i class="fa-solid fa-paperclip" aria-hidden="true"></i> Gerar arquivo de anexos'
                : '<i class="fa-solid fa-check" aria-hidden="true"></i> Gerar PDF';
            todosSlots().forEach(cfg => definirErroAnexo(cfg, ''));
        };

        document.querySelectorAll('input[name="modoGeracao"]').forEach(r => r.addEventListener('change', atualizarSecaoAnexos));

        configuracoesGroupEl.addEventListener('change', (e) => {
            if (e.target.id === 'apresentaraCertidoes') atualizarSecaoAnexos();
        });

        // --- Checkboxes da etapa 3 (preserva o que já estava marcado) ---
        const updateConfiguracoesCheckboxes = () => {
            const configuracoesGroup = configuracoesGroupEl;
            if (!configuracoesGroup) return;

            const estadoAnterior = {};
            configuracoesGroup.querySelectorAll('input[type="checkbox"]').forEach(cb => { estadoAnterior[cb.id] = cb.checked; });
            configuracoesGroup.innerHTML = '';

            const emendaChecked = document.getElementById('emenda')?.checked || false;
            const comissaoChecked = document.getElementById('comissao')?.checked || false;

            const checkboxes = [
                { id: 'possuiAreaGestora', label: 'O município possui área gestora dos recursos recebidos por transferência voluntária da União?', show: emendaChecked || comissaoChecked },
                {
                    id: 'apresentaraCertidoes',
                    label: 'O Município apresentará as Certidões emitidas pelo Tribunal de Justiça (TJ), Tribunal Regional do Trabalho (TRT) e Tribunal Regional Federal (TRF)?',
                    hint: 'Se não marcar, será gerada a Declaração de Regularidade no Pagamento de Precatórios Judiciais e você precisará anexar, em PDF, o comprovante de remessa ao Tribunal de Contas e o comprovante de impossibilidade de emissão das certidões. Esses anexos serão gerados em um arquivo PDF separado.',
                    show: comissaoChecked
                },
