            const uf = cidadeUF.split('/')[1] || 'UF';
            const novoTextoRodapeLongo = 'Declaração válida até a data limite de publicação do Relatório de Gestão Fiscal-RGF (ou Relatório Resumido da Execução Orçamentária – RREO subsequente - 30 dias após o encerramento do quadrimestre, juntamente com o comprovante de remessa da Declaração ao Tribunal de Contas)';
            const representanteText = cargo === 'Comandante-Geral' ? 'Representante' : `Representante do ${nomeEstadoMunicipio}`;
            const entityText = cargo === 'Comandante-Geral' ? '' : `${nomeEstadoMunicipio}/${uf}`;
            const addressText = cargo === 'Comandante-Geral' ? '' : `, endereço ${fullAddress}, CEP ${cep}, ${cidadeUF}`;
